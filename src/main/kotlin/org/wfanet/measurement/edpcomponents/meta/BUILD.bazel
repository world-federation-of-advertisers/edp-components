load("@rules_java//java:java_binary.bzl", "java_binary")
load("@wfa_rules_kotlin_jvm//kotlin:defs.bzl", "kt_jvm_grpc_proto_library", "kt_jvm_library", "kt_jvm_proto_library")

package(default_visibility = ["//visibility:public"])

# Kotlin codegen for the impression-query contract. The API repo ships only the proto_library, so
# the consumer generates the Kotlin from it.
kt_jvm_proto_library(
    name = "data_provider_impression_query_kt_jvm_proto",
    deps = [
        "@wfa_cross_media_measurement_api//src/main/proto/wfa/measurement/api/v2alpha:data_provider_impression_query_proto",
    ],
)

kt_jvm_proto_library(
    name = "event_group_kt_jvm_proto",
    deps = [
        "@wfa_cross_media_measurement_api//src/main/proto/wfa/measurement/api/v2alpha:event_group_proto",
    ],
)

# Client for the CMMS EventGroups service, used to resolve the ad account behind an entity.
kt_jvm_grpc_proto_library(
    name = "event_groups_service_kt_jvm_grpc_proto",
    deps = [
        "@wfa_cross_media_measurement_api//src/main/proto/wfa/measurement/api/v2alpha:event_groups_service_proto",
    ],
)

kt_jvm_library(
    name = "meta_impression_query",
    srcs = [
        "MetaAdAccountResolver.kt",
        "MetaEntityLevel.kt",
        "MetaEnvironment.kt",
        "MetaImpressionQueryFunction.kt",
        "MetaImpressionQueryMetrics.kt",
        "MetaInsightsClient.kt",
        "MetaMarketingApiInsightsClient.kt",
        "MetaTelemetry.kt",
    ],
    # Registers the `google_cloud_monitoring` exporter with OpenTelemetry autoconfiguration.
    runtime_deps = ["//imports/java/com/google/cloud/opentelemetry:exporter_auto"],
    deps = [
        ":data_provider_impression_query_kt_jvm_proto",
        ":event_group_kt_jvm_proto",
        ":event_groups_service_kt_jvm_grpc_proto",
        "//imports/java/com/google/cloud/functions:functions_framework_api",
        "//imports/java/com/google/gson",
        "//imports/java/com/google/protobuf",
        "//imports/java/io/grpc:api",
        "//imports/java/io/grpc/netty/shaded",
        "//imports/java/io/opentelemetry/api",
        "//imports/java/io/opentelemetry/sdk",
        "//imports/java/io/opentelemetry/sdk:sdk_autoconfigure",
        "//imports/java/io/opentelemetry/sdk:sdk_common",
        "//imports/java/io/opentelemetry/sdk:sdk_metrics",
        "//imports/kotlin/kotlinx/coroutines:core",
        "//imports/kotlin/org/wfanet/measurement/common/throttler",
    ],
)

# Gen-2 deployable artifact. See README.md for the deploy procedure.
java_binary(
    name = "MetaImpressionQueryFunction",
    main_class = "org.wfanet.measurement.edpcomponents.meta.MetaImpressionQueryFunction",
    runtime_deps = [":meta_impression_query"],
)
